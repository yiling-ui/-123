            <outline text="三重积分定义" />
            <outline text="直角坐标计算" />
            <outline text="柱面坐标" />
            <outline text="球面坐标" />
            <outline text="积分次序与体积因子" />
          </outline>
          <outline text="题型">
            <outline text="直角坐标三重积分" />
            <outline text="柱面坐标三重积分" />
            <outline text="球面坐标三重积分" />
