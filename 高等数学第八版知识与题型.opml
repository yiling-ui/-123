        <outline text="10.1 二重积分的概念与性质">
          <outline text="知识点">
            <outline text="二重积分定义" />
            <outline text="可积性" />
            <outline text="线性可加性" />
            <outline text="保号估值" />
            <outline text="中值性质" />
          </outline>
          <outline text="题型">
            <outline text="把和式极限写成二重积分" />
            <outline text="积分性质证明不等式" />
            <outline text="比较二重积分大小" />
            <outline text="选择区域使积分最大" />
          </outline>
        </outline>
        <outline text="10.2 二重积分的计算法">
          <outline text="知识点">
