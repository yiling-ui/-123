<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0">
  <head>
    <title>同济第八版知识与题型</title>
  </head>
  <body>
    <outline text="同济高等数学第八版">
      <outline text="第一章 函数与极限">
        <outline text="1.1 映射与函数">
          <outline text="知识点">
            <outline text="集合与对应关系" />
            <outline text="单射满射双射" />
            <outline text="定义域和值域" />
            <outline text="函数表示法" />
            <outline text="单调性有界性奇偶性周期性" />
            <outline text="反函数与复合函数" />
            <outline text="基本初等函数与初等函数" />
            <outline text="分段函数" />
            <outline text="隐函数与参数表示" />
            <outline text="双曲函数及恒等式" />
            <outline text="反双曲函数及对数表达式" />
          </outline>
          <outline text="题型">
            <outline text="判断单射满射双射" />
            <outline text="求定义域和值域" />
            <outline text="求反函数与复合函数" />
            <outline text="判断奇偶单调周期有界" />
            <outline text="建立分段函数与实际函数模型" />
            <outline text="双曲函数与反双曲函数的表达式" />
          </outline>
        </outline>
        <outline text="1.2 数列的极限">
          <outline text="知识点">
            <outline text="ε与N定义" />
            <outline text="收敛与发散" />
            <outline text="极限唯一性" />
            <outline text="收敛数列有界性" />
            <outline text="保号性" />
            <outline text="子数列与原数列" />
            <outline text="数列极限与子数列的关系" />
          </outline>
          <outline text="题型">
            <outline text="按定义证明数列极限" />
            <outline text="计算数列极限" />
            <outline text="判定数列收敛或发散" />
            <outline text="用收敛性质证明结论" />
            <outline text="递推数列极限" />
          </outline>
        </outline>
        <outline text="1.3 函数的极限">
          <outline text="知识点">
            <outline text="ε与δ定义" />
            <outline text="自变量趋于无穷" />
            <outline text="左极限与右极限" />
            <outline text="双侧极限存在条件" />
            <outline text="唯一性局部有界性局部保号性" />
          </outline>
          <outline text="题型">
            <outline text="按定义证明函数极限" />
            <outline text="求左极限右极限" />
            <outline text="判定极限存在" />
            <outline text="证明局部有界或保号" />
            <outline text="用不同趋近过程证明不存在" />
          </outline>
        </outline>
        <outline text="1.4 无穷小与无穷大">
          <outline text="知识点">
            <outline text="无穷小是过程中的变量" />
            <outline text="无穷小与极限的关系" />
            <outline text="无穷大与倒数关系" />
          </outline>
          <outline text="题型">
            <outline text="判断无穷小无穷大" />
            <outline text="把函数写成极限加无穷小" />
            <outline text="证明无穷小与无穷大关系" />
          </outline>
        </outline>
        <outline text="1.5 极限运算法则">
          <outline text="知识点">
            <outline text="和差积商法则" />
            <outline text="复合函数极限" />
            <outline text="分母极限非零条件" />
            <outline text="因式分解与有理化" />
            <outline text="有限个无穷小的和" />
            <outline text="有界函数乘无穷小" />
          </outline>
          <outline text="题型">
            <outline text="代入与四则运算求极限" />
            <outline text="因式分解消去零因子" />
            <outline text="根式有理化" />
            <outline text="含绝对值分段求极限" />
            <outline text="利用已知极限求未知极限" />
          </outline>
        </outline>
        <outline text="1.6 极限存在准则 两个重要极限">
          <outline text="知识点">
            <outline text="夹逼准则" />
            <outline text="单调有界准则" />
            <outline text="sinx除以x的重要极限" />
            <outline text="指数型重要极限" />
            <outline text="重要极限的变形" />
          </outline>
          <outline text="题型">
            <outline text="夹逼求极限" />
            <outline text="单调有界证明数列收敛" />
            <outline text="使用三角重要极限" />
            <outline text="使用指数型重要极限" />
            <outline text="递推与根式数列极限" />
          </outline>
        </outline>
        <outline text="1.7 无穷小的比较">
          <outline text="知识点">
            <outline text="高阶低阶同阶等价无穷小" />
            <outline text="无穷小的阶" />
            <outline text="等价替换的适用条件" />
            <outline text="乘除替换与加减的限制" />
          </outline>
          <outline text="题型">
            <outline text="比较无穷小阶数" />
            <outline text="求使两式等价的参数" />
            <outline text="等价无穷小计算极限" />
            <outline text="判断替换是否有效" />
          </outline>
        </outline>
        <outline text="1.8 函数的连续性与间断点">
          <outline text="知识点">
            <outline text="一点连续的三个条件" />
            <outline text="左连续与右连续" />
            <outline text="可去间断点" />
            <outline text="跳跃间断点" />
            <outline text="无穷间断点" />
            <outline text="振荡间断点" />
          </outline>
          <outline text="题型">
            <outline text="判定一点连续" />
            <outline text="求分段函数连续参数" />
            <outline text="找间断点并分类" />
            <outline text="讨论左右连续" />
          </outline>
        </outline>
        <outline text="1.9 连续函数的运算与初等函数的连续性">
          <outline text="知识点">
            <outline text="四则运算连续性" />
            <outline text="复合运算连续性" />
            <outline text="反函数连续性" />
            <outline text="初等函数定义区间内连续" />
          </outline>
          <outline text="题型">
            <outline text="利用连续性求极限" />
            <outline text="证明复合函数连续" />
            <outline text="确定初等函数连续区间" />
          </outline>
        </outline>
        <outline text="1.10 闭区间上连续函数的性质">
          <outline text="知识点">
            <outline text="最大值与上确界的区别" />
            <outline text="零点存在性" />
            <outline text="介值性" />
            <outline text="闭区间条件" />
            <outline text="★一致连续与逐点连续的区别" />
          </outline>
          <outline text="题型">
            <outline text="证明方程有根" />
            <outline text="证明值域含指定值" />
            <outline text="证明最值存在" />
            <outline text="介值定理证明等式" />
            <outline text="★判定与证明一致连续" />
          </outline>
        </outline>
      </outline>
      <outline text="第二章 导数与微分">
        <outline text="2.1 导数概念">
          <outline text="知识点">
            <outline text="差商与导数" />
            <outline text="左导数与右导数" />
            <outline text="切线与法线" />
            <outline text="导数的物理意义" />
            <outline text="可导蕴含连续" />
            <outline text="连续不一定可导" />
          </outline>
          <outline text="题型">
            <outline text="按定义求导数" />
            <outline text="分段函数连接点可导性" />
            <outline text="用导数定义计算极限" />
            <outline text="求切线法线" />
            <outline text="连续与可导的反例判断" />
          </outline>
        </outline>
        <outline text="2.2 函数的求导法则">
          <outline text="知识点">
            <outline text="四则求导" />
            <outline text="反函数求导" />
            <outline text="链式法则" />
            <outline text="基本初等函数导数" />
            <outline text="多层复合求导" />
            <outline text="双曲函数及反双曲函数求导" />
            <outline text="对数求导法" />
          </outline>
          <outline text="题型">
            <outline text="四则求导" />
            <outline text="多层复合函数求导" />
            <outline text="反函数导数" />
            <outline text="含指数对数三角函数求导" />
            <outline text="对数求导法处理幂指函数" />
            <outline text="双曲函数及反双曲函数求导" />
          </outline>
        </outline>
        <outline text="2.3 高阶导数">
          <outline text="知识点">
            <outline text="二阶与n阶导数" />
            <outline text="高阶导数记号" />
            <outline text="常见函数高阶导数" />
            <outline text="★莱布尼茨高阶乘积求导公式" />
          </outline>
          <outline text="题型">
            <outline text="求二阶或n阶导数" />
            <outline text="归纳高阶导数公式" />
            <outline text="利用乘积求高阶导数" />
            <outline text="★莱布尼茨公式求高阶导数" />
          </outline>
        </outline>
        <outline text="2.4 隐函数及由参数方程所确定的函数的导数 相关变化率">
          <outline text="知识点">
            <outline text="隐式关系两边求导" />
            <outline text="参数形式一阶与二阶导数" />
            <outline text="相关变化率建模" />
          </outline>
          <outline text="题型">
            <outline text="隐函数一阶二阶导数" />
            <outline text="参数曲线一阶二阶导数" />
            <outline text="隐式或参数曲线切线" />
            <outline text="相关变化率应用" />
          </outline>
        </outline>
        <outline text="2.5 函数的微分">
          <outline text="知识点">
            <outline text="线性主部" />
            <outline text="微分与增量" />
            <outline text="微分形式不变性" />
            <outline text="微分公式" />
            <outline text="近似计算与误差" />
          </outline>
          <outline text="题型">
            <outline text="求函数微分" />
            <outline text="分段函数可微性" />
            <outline text="用微分估算函数值" />
            <outline text="估计绝对与相对误差" />
          </outline>
        </outline>
      </outline>
      <outline text="第三章 微分中值定理与导数的应用">
        <outline text="3.1 微分中值定理">
          <outline text="知识点">
            <outline text="罗尔定理条件与结论" />
            <outline text="拉格朗日中值定理" />
            <outline text="柯西中值定理" />
            <outline text="辅助函数构造" />
            <outline text="恒等式不等式与根的证明" />
          </outline>
          <outline text="题型">
            <outline text="验证中值定理条件" />
