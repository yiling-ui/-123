            <outline text="对称性" />
            <outline text="★一般换元与雅可比" />
          </outline>
          <outline text="题型">
            <outline text="先x后y与先y后x计算" />
            <outline text="交换积分次序" />
            <outline text="极坐标计算" />
            <outline text="对称性简化" />
            <outline text="★一般换元计算" />
            <outline text="分区积分" />
          </outline>
        </outline>
        <outline text="10.3 三重积分">
