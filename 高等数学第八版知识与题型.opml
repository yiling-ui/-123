            <outline text="求凹凸区间与拐点" />
            <outline text="参数影响单调性与凹凸性" />
          </outline>
        </outline>
        <outline text="3.5 函数的极值与最大值最小值">
          <outline text="知识点">
            <outline text="驻点与不可导点" />
            <outline text="极值必要条件" />
            <outline text="一阶导数判别" />
            <outline text="二阶导数判别" />
            <outline text="端点与最值" />
            <outline text="优化建模" />
          </outline>
          <outline text="题型">
            <outline text="求驻点与极值" />
            <outline text="闭区间最大最小值" />
            <outline text="带参数极值问题" />
            <outline text="几何经济物理优化" />
          </outline>
        </outline>
        <outline text="3.6 函数图形的描绘">
